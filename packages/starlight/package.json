{
	"name": "starlight-pele",
	"version": "0.1.0",
	"description": "Starlight plugin that renders Mermaid fences to themeable SVG with Pele.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"starlight",
		"astro",
		"mermaid",
		"pele",
		"svg",
		"diagrams",
		"documentation"
	],
	"homepage": "https://t128n.github.io/pele-x/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/t128n/pele-x.git",
		"directory": "packages/starlight"
	},
	"bugs": {
		"url": "https://github.com/t128n/pele-x/issues"
	},
	"files": [
		"dist",
		"theme.css",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./theme.css": "./theme.css"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"astro-pele": "workspace:*"
	},
	"peerDependencies": {
		"@astrojs/starlight": "^0.42.0",
		"astro": "^7.2.0"
	}
}
