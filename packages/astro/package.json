{
	"name": "astro-pele",
	"version": "0.1.2",
	"description": "Astro integration that renders Mermaid fences to static SVG with Pele.",
	"keywords": [
		"astro",
		"astro-integration",
		"diagrams",
		"mermaid",
		"pele",
		"svg"
	],
	"homepage": "https://t128n.github.io/pele-x/",
	"bugs": {
		"url": "https://github.com/t128n/pele-x/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/t128n/pele-x.git",
		"directory": "packages/astro"
	},
	"files": [
		"dist",
		"src/Pele.astro",
		"theme.css",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./zoom": {
			"types": "./dist/zoom.d.ts",
			"import": "./dist/zoom.js"
		},
		"./Pele.astro": "./src/Pele.astro",
		"./theme.css": "./theme.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"mdast-pele": "workspace:*"
	},
	"peerDependencies": {
		"astro": "^7.2.0",
		"pele": "^1.10.0"
	},
	"engines": {
		"node": ">=22.23.4"
	}
}
