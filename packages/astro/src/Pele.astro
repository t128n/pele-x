---
import { renderDiagram } from 'mdast-pele';

interface Props {
	source: string;
	title?: string;
	zoom?: boolean;
}

const { source, title, zoom = false } = Astro.props;
const { svg } = renderDiagram(source);
---

<figure class="pele-diagram" data-pele-zoom={zoom ? '' : undefined}>
	<Fragment set:html={svg} />
	{title ? <figcaption>{title}</figcaption> : null}
</figure>
