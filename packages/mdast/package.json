{
	"name": "mdast-pele",
	"version": "0.1.1",
	"description": "Render Mermaid fences to static SVG with Pele in remark and Sätteri pipelines.",
	"keywords": [
		"diagrams",
		"markdown",
		"mdast",
		"mermaid",
		"pele",
		"remark",
		"satteri",
		"svg"
	],
	"homepage": "https://t128n.github.io/pele-x/",
	"bugs": {
		"url": "https://github.com/t128n/pele-x/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/t128n/pele-x.git",
		"directory": "packages/mdast"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./remark": {
			"types": "./dist/remark.d.ts",
			"import": "./dist/remark.js"
		},
		"./satteri": {
			"types": "./dist/satteri.d.ts",
			"import": "./dist/satteri.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@types/mdast": "4.0.4",
		"@types/unist": "3.0.3",
		"pele": "1.13.0",
		"unist-util-visit": "5.2.0"
	},
	"engines": {
		"node": ">=20"
	}
}
